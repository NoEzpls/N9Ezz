+    private static void check(boolean value,String why){checks++;if(!value)throw new AssertionError(why);}
+    private static TriggerV2Controller fresh(){
+        RewriteProbe.world();RewriteProbe.target(1,0,2,10);
+        N9Ezz.TRIGGER.exactHit.set(true);N9Ezz.TRIGGER.confirmation.set(100);
+        return new TriggerV2Controller(N9Ezz.TRIGGER);
+    }
+    private static void ready(TriggerV2Controller controller){
+        controller.tick(START);controller.tick(START+100_000_000L);
+        check(e.requests==1,"initial target confirmed once");
+    }
+    private static void miss(TriggerV2Controller controller,long now){
+        mc.field_1724.yaw=90;controller.tick(now);
+        check(controller.target()==null,"missing ray has no active target");
+        mc.field_1724.yaw=0;
+    }
+    public static void main(String[] args){
+        TriggerV2Controller controller=fresh();ready(controller);
+        miss(controller,START+120_000_000L);
+        // No intervening miss callback runs while the client is stalled. The
+        // grace period must be evaluated BEFORE refreshing lastSeen on return.
+        controller.tick(START+1_000_000_000L);
+        check(e.requests==1,"expired confirmation must not survive a stalled reacquisition");
+        controller.tick(START+1_099_999_999L);
+        check(e.requests==1,"new confirmation waits for its complete duration");
+        controller.tick(START+1_100_000_000L);
+        check(e.requests==2,"reacquired target attacks after fresh confirmation");
+
+        controller=fresh();ready(controller);c clock=e.lastClock;
+        clock.m3(START+100_000_000L);
+        miss(controller,START+120_000_000L);controller.tick(START+130_000_000L);
+        check(e.requests==2&&e.lastClock==clock,"brief miss retains confirmation and the existing pacing clock");
+        check(!clock.m2(START+130_000_000L,10,0,1,1),"retention does not reset the attack interval");
+
+        controller=fresh();ready(controller);miss(controller,START+120_000_000L);
+        controller.tick(START+250_000_000L);
+        check(e.requests==2,"inclusive 150ms retention boundary preserves prior behavior");
+        controller=fresh();ready(controller);miss(controller,START+120_000_000L);
+        controller.tick(START+250_000_001L);
+        check(e.requests==1,"one nanosecond beyond retention requires confirmation");
+
+        controller=fresh();controller.retainMs.set(0);
+        controller.tick(START);controller.tick(START+50_000_000L);controller.tick(START+100_000_000L);
+        check(e.requests==1,"zero miss retention must not prevent continuously tracked confirmation");
+        miss(controller,START+120_000_000L);controller.tick(START+130_000_000L);
+        check(e.requests==1,"zero retention requires new confirmation after loss");
